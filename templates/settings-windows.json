  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "_note": "On Windows: hooks are invoked as 'command' strings. Python must be in PATH. 2>NUL replaces 2>/dev/null.",
            "type": "command",
            "command": "python ~/.claude/hooks/session_start_reinforcement.py 2>NUL & exit /b 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/session_startup_hook.py 2>NUL & exit /b 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/session_startup_dashboard.py 2>NUL & exit /b 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/session_health_check.py 2>NUL & exit /b 0",
            "timeout": 5
          },
          {
            "_note": "gc-mcp.exe must be compiled for windows/amd64. See docs/WINDOWS_PORTING.md Section 4.",
            "type": "command",
            "command": "%USERPROFILE%\\.claude\\mcp-servers\\gc-mcp\\gc-mcp.exe --quick 2>NUL & exit /b 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "_note": "session_end_hook.py has fcntl — must be ported before enabling. See WINDOWS_PORTING.md Section 3.",
            "type": "command",
            "command": "python ~/.claude/hooks/session_end_hook.py 2>NUL & exit /b 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
